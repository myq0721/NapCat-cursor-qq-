# Cursor API — https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_xxx

# Bot owner QQ (commands: /学习 /导入素材 /切换模型)
OWNER_QQ_ID=

# Persona import from sucai.txt (optional; for persona:build / import:sucai)
STYLE_PERSON_NAME=
STYLE_PERSON_QQ=
SUACAI_PATH=sucai.txt

IMPORT_MAX_SAMPLES=2000
LEARN_SAMPLE_COUNT=2000
LEARN_BATCH_SIZE=60
STYLE_EXAMPLE_COUNT=50
AUTO_IMPORT_SUACAI=false

CURSOR_MODEL=composer-2.5
CURSOR_CWD=

# NapCat reverse WebSocket → this bot listens
ONEBOT_WS_HOST=127.0.0.1
ONEBOT_WS_PORT=8080
ONEBOT_WS_PATH=/onebot/v11/ws

# NapCat HTTP (send messages)
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_TOKEN=

# Bot QQ (recommended; used for @ detection)
BOT_QQ_ID=

GROUP_PROACTIVE_INTERVAL_MS=1200000
GROUP_HISTORY_LIMIT=50
CHAT_FAST_MODE=true
MAX_REPLY_LENGTH=3500
HASH_REPLY_MAX_LENGTH=4000
